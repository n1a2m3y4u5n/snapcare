# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# === 백업용 공통 제외 (자동 추가) ===
# === 자동 생성/의존성 (깃허브에 올리지 않음) ===
node_modules/
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
dist/
build/
.next/
.expo/
.turbo/
.cache/
*.tsbuildinfo
coverage/

# === 환경변수·비밀정보 (.example 템플릿은 유지) ===
.env
.env.*
!.env.example
!.env.sample
*.key
*.pem
serviceAccount*.json

# === OS·에디터 ===
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# 서버 저장소 (로컬)
.data/

# 폼시트 판독용 로컬 파이썬 (프로덕션은 이미지에 apk 로 설치)
.venv-cv/

# 빌드 때 nutrition_manager/web/model 에서 복사된다 (scripts/copy-model.mjs)
public/models/

# 글리프 밑그림 — 보고 그리는 용도이고 앱에 들어가지 않는다
engine/refs/

# 실행 중에 만든 글리프 — 서버가 필요할 때 다시 만든다. 사람 검토를 거치지
# 않은 그림이라 검토된 78개(engine/assets)와 같은 자리에 두지 않는다.
public/glyphs-gen/

# OCR 자산 — scripts/copy-ocr.mjs 가 node_modules 와 CDN 에서 채운다 (14MB)
public/ocr/

# 전문가 연락처 — 실명과 이메일이 들어 있다. 대회 조직 계정 아래 레포이므로
# 개인정보를 올리지 않는다. 문서 작성용 자료이며 로컬에만 둔다.
scratchpad/contacts/
scratchpad/email_list.md
scratchpad/experts.md
