# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# === 백업용 공통 제외 (자동 추가) ===
# === 자동 생성/의존성 (깃허브에 올리지 않음) ===
node_modules/
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
dist/
build/
.next/
.expo/
.turbo/
.cache/
*.tsbuildinfo
coverage/

# === 환경변수·비밀정보 (.example 템플릿은 유지) ===
.env
.env.*
!.env.example
!.env.sample
*.key
*.pem
serviceAccount*.json

# === OS·에디터 ===
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
