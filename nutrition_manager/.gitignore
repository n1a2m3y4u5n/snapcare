# Generated artifacts (reproducible via build_labels.py / build_dataset.py / train.py / eval.py)
__pycache__/
checkpoints/
data/labels.csv
dataset_processed/
# eval.py names non-benchmark runs after the model and split that produced them.
predictions*.csv
groundtruth_test*.csv
eval_stats*.json
nutrition5k_dataset/

# Run logs; history.jsonl and the scripts are kept.
runs/*.log
# Scratch area for exports. The graph that actually ships is committed under
# web/model/, so the app can be integrated without a GPU or a training run.
export/
web/node_modules/
