<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-API-26 fallback: the same mark on its background, as a plain layer list.
     Adaptive icons are only understood from 26, and minSdk here is 24. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:top="18dp"
        android:bottom="18dp"
        android:left="18dp"
        android:right="18dp" />
</layer-list>
